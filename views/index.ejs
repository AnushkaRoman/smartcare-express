<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>SmartCare - Book Appointment</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

    <!-- Navigation -->

    <nav class="navbar">

        <div class="logo">
            SmartCare
        </div>

        <div class="nav-text">
            Doctor Appointment System
        </div>

    </nav>


    <!-- Main Container -->

    <main class="container">

        <div class="header">

            <h1>Book an Appointment</h1>

            <p>
                Please provide your details to schedule
                a doctor appointment.
            </p>

        </div>


        <!-- Appointment Form -->

        <form
            action="/appointments"
            method="POST"
            class="appointment-form"
        >


            <!-- Name -->

            <div class="form-group">

                <label for="name">
                    Full Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your full name"
                    value="<%= formData.name || '' %>"
                >

                <% if (errors.name) { %>

                    <p class="error">
                        <%= errors.name %>
                    </p>

                <% } %>

            </div>


            <!-- Email -->

            <div class="form-group">

                <label for="email">
                    Email Address
                </label>

                <input
                    type="text"
                    id="email"
                    name="email"
                    placeholder="example@email.com"
                    value="<%= formData.email || '' %>"
                >

                <% if (errors.email) { %>

                    <p class="error">
                        <%= errors.email %>
                    </p>

                <% } %>

            </div>


            <!-- Phone -->

            <div class="form-group">

                <label for="phone">
                    Phone Number
                </label>

                <input
                    type="text"
                    id="phone"
                    name="phone"
                    placeholder="10-digit phone number"
                    value="<%= formData.phone || '' %>"
                >

                <% if (errors.phone) { %>

                    <p class="error">
                        <%= errors.phone %>
                    </p>

                <% } %>

            </div>


            <!-- Age -->

            <div class="form-group">

                <label for="age">
                    Age
                </label>

                <input
                    type="number"
                    id="age"
                    name="age"
                    placeholder="Enter your age"
                    value="<%= formData.age || '' %>"
                >

                <% if (errors.age) { %>

                    <p class="error">
                        <%= errors.age %>
                    </p>

                <% } %>

            </div>


            <!-- Department -->

            <div class="form-group">

                <label for="department">
                    Medical Department
                </label>

                <select
                    id="department"
                    name="department"
                >

                    <option value="">
                        Select Department
                    </option>

                    <option
                        value="General Medicine"
                        <%= formData.department === "General Medicine"
                            ? "selected"
                            : "" %>
                    >
                        General Medicine
                    </option>

                    <option
                        value="Cardiology"
                        <%= formData.department === "Cardiology"
                            ? "selected"
                            : "" %>
                    >
                        Cardiology
                    </option>

                    <option
                        value="Dermatology"
                        <%= formData.department === "Dermatology"
                            ? "selected"
                            : "" %>
                    >
                        Dermatology
                    </option>

                    <option
                        value="Orthopedics"
                        <%= formData.department === "Orthopedics"
                            ? "selected"
                            : "" %>
                    >
                        Orthopedics
                    </option>

                    <option
                        value="Pediatrics"
                        <%= formData.department === "Pediatrics"
                            ? "selected"
                            : "" %>
                    >
                        Pediatrics
                    </option>

                </select>

                <% if (errors.department) { %>

                    <p class="error">
                        <%= errors.department %>
                    </p>

                <% } %>

            </div>


            <!-- Appointment Date -->

            <div class="form-group">

                <label for="appointmentDate">
                    Appointment Date
                </label>

                <input
                    type="date"
                    id="appointmentDate"
                    name="appointmentDate"
                    value="<%= formData.appointmentDate || '' %>"
                >

                <% if (errors.appointmentDate) { %>

                    <p class="error">
                        <%= errors.appointmentDate %>
                    </p>

                <% } %>

            </div>


            <!-- Reason -->

            <div class="form-group">

                <label for="reason">
                    Reason for Visit
                </label>

                <textarea
                    id="reason"
                    name="reason"
                    placeholder="Describe your reason for the appointment..."
                ><%= formData.reason || '' %></textarea>

                <% if (errors.reason) { %>

                    <p class="error">
                        <%= errors.reason %>
                    </p>

                <% } %>

            </div>


            <!-- Submit -->

            <button
                type="submit"
                class="submit-btn"
            >
                Book Appointment
            </button>

        </form>

    </main>


    <footer>

        <p>
            © 2026 SmartCare | Express.js Server-Side Validation
        </p>

    </footer>


    <script src="/js/script.js"></script>

</body>

</html>